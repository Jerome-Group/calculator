{
  "name": "calculator",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-pnpm.sh",
    "dev": "node scripts/prepare-engine.mjs && node scripts/run-framework.mjs dev",
    "build": "node scripts/prepare-engine.mjs && node scripts/run-framework.mjs build && node scripts/offline-manifest.mjs dist/client",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test": "node tests/engine-preparation.mjs && node scripts/prepare-engine.mjs && node --import ./tests/resolve-types.mjs tests/release.mjs && node --import ./tests/resolve-types.mjs tests/persistence.mjs && node --experimental-vm-modules tests/sync.mjs",
    "test:assets": "node tests/assets.mjs",
    "format:check": "prettier --check \"app/**/*.{ts,tsx}\" \"components/calculator/**/*.{ts,tsx}\" \"lib/**/*.{ts,tsx}\" \"build/*.ts\" \"scripts/*.{mjs,json}\" \"tests/*.mjs\" \"public/{compute-worker,sw}.js\" \"*.json\" \"*.mjs\" \"*.ts\" \".openai/*.json\" \".github/**/*.yml\" README.md AGENTS.md MAP.md CONTEXT.md docs/adr/0002-public-mit-source.md docs/adr/0003-sites-runtime-and-verification.md docs/PRODUCT_BRIEF.md docs/VALIDATION.md docs/adr/0004-generated-engine-artifacts.md",
    "prepare:engine": "node scripts/prepare-engine.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "katex": "0.16.22",
    "lucide-react": "^1.31.0",
    "mathjs": "14.8.1",
    "mathlive": "0.109.2",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "plotly.js-dist-min": "3.1.0",
    "pyodide": "0.27.7",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "prettier": "3.6.2",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  },
  "packageManager": "pnpm@11.25.0",
  "license": "MIT"
}
